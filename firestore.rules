rules_version = '2';

// Firebase 콘솔 > Firestore Database > 규칙(Rules) 탭에 이 내용을 그대로 붙여넣으세요.
// 로그인한(Authentication에 계정이 있는) 사용자만 예산 데이터를 읽고 쓸 수 있습니다.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
